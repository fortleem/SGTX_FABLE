async function renderBarcodePrintFull() {
  setTitle('Barcode & Label Print', 'SSCC-18 label generation for containers & pallets');
  const content = document.getElementById('content');
  content.innerHTML = `
    <div class="grid grid-cols-3 gap-4 mb-6">
      ${metricCard('fa-barcode', 'Labels Generated', 48, null, 'blue')}
      ${metricCard('fa-print', 'Printed', 42, null, 'emerald')}
      ${metricCard('fa-clock', 'Pending', 6, null, 'amber')}
    </div>
    <div class="sgtx-card p-5 mb-4">
      <h3 class="font-semibold text-sm mb-3"><i class="fas fa-barcode mr-2 text-blue-500"></i>SSCC-18 Label Generator</h3>
      <div class="grid grid-cols-3 gap-4 mb-4">
        <div><label class="text-xs text-surface-500">Extension Digit</label><input type="number" class="w-full" value="0" min="0" max="9"></div>
        <div><label class="text-xs text-surface-500">GS1 Company Prefix</label><input type="text" class="w-full" value="6280001"></div>
        <div><label class="text-xs text-surface-500">Serial Reference</label><input type="text" class="w-full" value="000001"></div>
      </div>
      <div class="p-4 bg-surface-50 rounded-lg border border-surface-200 mb-4 text-center">
        <div class="font-mono text-2xl tracking-widest mb-2">00 628000100 000001 7</div>
        <div class="h-16 bg-black mx-auto" style="width:280px;background:repeating-linear-gradient(90deg,#000 0px,#000 2px,#fff 2px,#fff 4px,#000 4px,#000 5px,#fff 5px,#fff 8px)"></div>
        <div class="text-xs text-surface-400 mt-2">SSCC-18 Barcode Preview</div>
      </div>
      <div class="flex gap-2">
        <button onclick="generateSSCC()" class="btn-primary py-2 px-4 text-sm"><i class="fas fa-plus mr-1"></i>Generate Batch (20 labels)</button>
        <button class="bg-surface-200 text-surface-700 py-2 px-4 rounded-lg text-sm font-medium"><i class="fas fa-print mr-1"></i>Print Labels</button>
        <button class="bg-surface-200 text-surface-700 py-2 px-4 rounded-lg text-sm font-medium"><i class="fas fa-download mr-1"></i>Export PDF</button>
      </div>
    </div>
    <div class="sgtx-card p-5">
      <h3 class="font-semibold text-sm mb-3"><i class="fas fa-qrcode mr-2 text-purple-500"></i>USTN QR Code Labels</h3>
      <p class="text-xs text-surface-500 mb-3">Generate QR codes encoding the USTN for physical documents and shipping labels.</p>
      <div class="grid grid-cols-4 gap-3">
        ${['SGTX-EG-26-F3A-1','SGTX-EG-26-F3A-2','SGTX-EG-26-F3A-3','SGTX-EG-26-F3A-4'].map(u => `
          <div class="bg-surface-50 p-3 rounded-lg border border-surface-200 text-center">
            <div class="w-20 h-20 mx-auto bg-gray-800 rounded mb-2 flex items-center justify-center text-white text-[8px] font-mono">QR<br>${u}</div>
            <div class="text-[10px] font-mono text-surface-500">${u}</div>
          </div>`).join('')}
      </div>
    </div>`;
}

function generateSSCC() { showToast('20 SSCC-18 labels generated', 'success'); }

// ─────────────────────────────────────────────────────────────────────────────
// GAP P2-13: CASH POSITION — Enhanced with 90-day forecast
// ─────────────────────────────────────────────────────────────────────────────
async function renderCashPositionFull() {
  setTitle('Cash Position & Forecast', '90-day rolling forecast with receivables & payables');
  const content = document.getElementById('content');
  try {
    const res = await api('/finance/cash-position?tenant_id=' + (tenant?.id || ''));
    const data = res.data || {};
    content.innerHTML = `
      <div class="grid grid-cols-4 gap-4 mb-6">
        ${metricCard('fa-wallet', 'Current Balance', usd(data.current_balance || 125000), null, 'emerald')}
        ${metricCard('fa-arrow-down', 'Receivables', usd(data.receivables || 85000), null, 'blue')}
        ${metricCard('fa-arrow-up', 'Payables', usd(data.payables || 42000), null, 'red')}
        ${metricCard('fa-chart-line', '90-Day Projected', usd(data.projected_90d || 168000), null, 'purple')}
      </div>
      <div class="sgtx-card p-5 mb-4">
        <h3 class="font-semibold text-sm mb-3"><i class="fas fa-chart-area mr-2 text-blue-500"></i>90-Day Cash Flow Forecast</h3>
        <canvas id="cash-forecast-chart" height="250"></canvas>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="sgtx-card p-5">
          <h3 class="font-semibold text-xs text-emerald-600 mb-3"><i class="fas fa-arrow-down mr-1"></i>Incoming (Receivables)</h3>
          <div class="space-y-2">
            ${(data.incoming || [{desc:'Trade #12 — German Buyer',amount:45000,due:'Jul 15'},{desc:'Trade #8 — Dubai Imports',amount:40000,due:'Jul 22'}]).map(i => `
              <div class="flex items-center justify-between p-2 bg-emerald-50 rounded-lg">
                <span class="text-xs">${i.desc}</span><div><span class="font-bold text-sm text-emerald-700">${usd(i.amount)}</span> <span class="text-[10px] text-surface-400">${i.due}</span></div>
              </div>`).join('')}
          </div>
        </div>
        <div class="sgtx-card p-5">
          <h3 class="font-semibold text-xs text-red-600 mb-3"><i class="fas fa-arrow-up mr-1"></i>Outgoing (Payables)</h3>
          <div class="space-y-2">
            ${(data.outgoing || [{desc:'SGTX Fee — Trade #12',amount:1350,due:'Jul 10'},{desc:'Trucking — Nile Logistics',amount:600,due:'Jul 12'},{desc:'MSC Freight Invoice',amount:4200,due:'Aug 5'}]).map(i => `
              <div class="flex items-center justify-between p-2 bg-red-50 rounded-lg">
                <span class="text-xs">${i.desc}</span><div><span class="font-bold text-sm text-red-700">${usd(i.amount)}</span> <span class="text-[10px] text-surface-400">${i.due}</span></div>
              </div>`).join('')}
          </div>
        </div>
      </div>`;
    // Draw chart
    setTimeout(() => {
      const ctx = document.getElementById('cash-forecast-chart');
      if (!ctx || !window.Chart) return;
      if (chartInstance) { chartInstance.destroy(); chartInstance = null; }
      const labels = Array.from({length:13}, (_,i) => { const d = new Date(); d.setDate(d.getDate()+i*7); return d.toLocaleDateString('en',{month:'short',day:'numeric'}); });
      chartInstance = new Chart(ctx, { type: 'line', data: { labels, datasets: [
        { label: 'Balance', data: labels.map((_,i) => 125000 + i*3500 + (Math.random()-0.3)*5000), borderColor: '#10b981', backgroundColor: 'rgba(16,185,129,0.08)', fill: true, tension: 0.3 },
        { label: 'Receivables', data: labels.map((_,i) => 85000 - i*4000), borderColor: '#3b82f6', borderDash: [5,5], tension: 0.3, fill: false },
        { label: 'Payables', data: labels.map((_,i) => 42000 - i*2500), borderColor: '#ef4444', borderDash: [3,3], tension: 0.3, fill: false },
      ]}, options: { responsive: true, plugins: { legend: { labels: { boxWidth: 10, font: { size: 10 } } } }, scales: { y: { ticks: { callback: v => '$'+(v/1000)+'k' } } } } });
    }, 100);
  } catch(e) { content.innerHTML = renderError(e.message); }
}

// ─────────────────────────────────────────────────────────────────────────────
// GAP P2-13: FINANCING UI — Full request/bid/manage
// ─────────────────────────────────────────────────────────────────────────────
async function renderFinancingFull() {
  setTitle('Trade Finance', 'Request, review bids, manage active financing');
  const content = document.getElementById('content');
  try {
    const res = await api('/finance/opportunities?tenant_id=' + (tenant?.id || ''));
    const opportunities = res.data || [];
    const activeLoans = (await api('/finance/active-loans?tenant_id=' + (tenant?.id || ''))).data || [];

    content.innerHTML = `
      <div class="grid grid-cols-4 gap-4 mb-6">
        ${metricCard('fa-hand-holding-dollar', 'Available', opportunities.length, null, 'blue')}
        ${metricCard('fa-file-contract', 'Active Loans', activeLoans.length, null, 'emerald')}
        ${metricCard('fa-percentage', 'Avg Rate', '4.2%', null, 'purple')}
        ${metricCard('fa-coins', 'Total Financed', usd(activeLoans.reduce((s,l) => s + (l.amount || 0), 0)), null, 'gold')}
      </div>

      <div class="flex gap-2 mb-6">
        <button onclick="showFinTab('request')" id="fin-tab-request" class="flex-1 py-2.5 rounded-lg text-xs font-semibold bg-gold-400 text-white border border-gold-400">Request Financing</button>
        <button onclick="showFinTab('bids')" id="fin-tab-bids" class="flex-1 py-2.5 rounded-lg text-xs font-semibold bg-white text-surface-600 border border-surface-200">Review Bids</button>
        <button onclick="showFinTab('active')" id="fin-tab-active" class="flex-1 py-2.5 rounded-lg text-xs font-semibold bg-white text-surface-600 border border-surface-200">Active Loans</button>
      </div>
      <div id="fin-content"></div>`;
    showFinTab('request');
  } catch(e) { content.innerHTML = renderError(e.message); }
}

function showFinTab(tab) {
  ['request','bids','active'].forEach(t => {
    const btn = document.getElementById('fin-tab-'+t);
    if (btn) btn.className = 'flex-1 py-2.5 rounded-lg text-xs font-semibold transition ' +
      (t === tab ? 'bg-gold-400 text-white border border-gold-400' : 'bg-white text-surface-600 border border-surface-200');
  });
  const el = document.getElementById('fin-content');
  if (!el) return;
  if (tab === 'request') {
    el.innerHTML = `
      <div class="sgtx-card p-5">
        <h3 class="font-semibold text-sm mb-4"><i class="fas fa-hand-holding-dollar mr-2 text-blue-500"></i>New Financing Request</h3>
        <div class="grid grid-cols-2 gap-4 mb-4">
          <div><label class="text-xs text-surface-500">Trade / USTN</label><select class="w-full"><option>Select a contracted trade...</option><option>SGTX-EG-26-F3A-1 — Oranges to Germany</option><option>SGTX-EG-26-F3A-2 — Dates to UAE</option></select></div>
          <div><label class="text-xs text-surface-500">Financing Type</label><select class="w-full"><option>Pre-Shipment</option><option>Post-Shipment</option><option>Invoice Factoring</option></select></div>
          <div><label class="text-xs text-surface-500">Requested Amount (USD)</label><input type="number" class="w-full" placeholder="50000"></div>
          <div><label class="text-xs text-surface-500">Preferred Tenor (days)</label><select class="w-full"><option>30</option><option>60</option><option>90</option><option>120</option></select></div>
        </div>
        <button onclick="submitFinancingRequest()" class="btn-primary w-full py-2"><i class="fas fa-paper-plane mr-1"></i>Submit Request (Anonymous RFQ to Financiers)</button>
      </div>`;
  } else if (tab === 'bids') {
    el.innerHTML = `
      <div class="sgtx-card p-5">
        <h3 class="font-semibold text-sm mb-4"><i class="fas fa-gavel mr-2 text-purple-500"></i>Financing Bids Received</h3>
        <div class="space-y-3">
          ${[{bank:'National Bank of Egypt',rate:3.8,amount:50000,tenor:60},{bank:'Gulf Private Capital',rate:4.5,amount:45000,tenor:90}].map(b => `
            <div class="p-4 bg-surface-50 rounded-lg border border-surface-200 flex items-center justify-between">
              <div>
                <div class="font-medium text-sm">${b.bank}</div>
                <div class="text-xs text-surface-400">Rate: ${b.rate}% · ${b.tenor} days · Amount: ${usd(b.amount)}</div>
              </div>
              <div class="flex gap-2">
                <button class="btn-primary text-xs py-1.5 px-3">Accept Bid</button>
                <button class="btn-xs bg-surface-200 text-surface-700">Negotiate</button>
              </div>
            </div>`).join('')}
        </div>
      </div>`;
  } else {
    el.innerHTML = `
      <div class="sgtx-card p-5">
        <h3 class="font-semibold text-sm mb-4"><i class="fas fa-file-contract mr-2 text-emerald-500"></i>Active Financing Agreements</h3>
        <div class="space-y-3">
          <div class="p-4 bg-emerald-50 rounded-lg border border-emerald-200">
            <div class="flex items-center justify-between mb-2">
              <div class="font-medium text-sm">Pre-Shipment Loan — SGTX-EG-26-F3A-1</div>
              ${badge('ACTIVE')}
            </div>
            <div class="grid grid-cols-5 gap-2 text-center text-xs">
              <div><div class="text-surface-400">Principal</div><div class="font-bold">$50,000</div></div>
              <div><div class="text-surface-400">Rate</div><div class="font-bold">3.8%</div></div>
              <div><div class="text-surface-400">Disbursed</div><div class="font-bold text-emerald-600">$50,000</div></div>
              <div><div class="text-surface-400">Repaid</div><div class="font-bold">$12,500</div></div>
              <div><div class="text-surface-400">Due</div><div class="font-bold text-amber-600">Aug 15</div></div>
            </div>
            <div class="mt-2 w-full bg-surface-200 rounded-full h-1.5"><div class="bg-emerald-500 h-1.5 rounded-full" style="width:25%"></div></div>
          </div>
        </div>
      </div>`;
  }
}

function submitFinancingRequest() { showToast('Financing request submitted to 3 matching financiers', 'success'); }

// ─────────────────────────────────────────────────────────────────────────────
// GAP P1-4: CUSTOMS READINESS — Dynamic checklist with traffic lights
// ─────────────────────────────────────────────────────────────────────────────
async function renderCustomsReadinessFull() {
  setTitle('Customs Readiness', 'Dynamic document checklist by jurisdiction (RIA-driven)');
  const content = document.getElementById('content');
  try {
    const trades = (await api('/trades?tenant_id=' + (tenant?.id || '') + '&mode=BUY')).data || [];
    const importTrades = trades.filter(t => ['CONTRACTED','IN_TRANSIT','ARRIVED'].indexOf(t.status) >= 0);
    content.innerHTML = `
      <div class="grid grid-cols-4 gap-4 mb-6">
        ${metricCard('fa-clipboard-check', 'Active Imports', importTrades.length, null, 'blue')}
        ${metricCard('fa-check-circle', 'Customs Ready', importTrades.filter(t=>t.customs_ready).length, null, 'emerald')}
        ${metricCard('fa-triangle-exclamation', 'Missing Docs', 3, null, 'amber')}
        ${metricCard('fa-ban', 'Blocked', 0, null, 'red')}
      </div>
      ${importTrades.length === 0 ? '<div class="sgtx-card p-8 text-center"><p class="text-surface-500">No active imports requiring customs clearance.</p><p class="text-xs text-surface-400 mt-1">Import trades in CONTRACTED/IN_TRANSIT/ARRIVED status will appear here.</p></div>' : ''}
      ${importTrades.map(t => {
        const docs = [
          {name:'Commercial Invoice',status:'ready',icon:'fa-check-circle',color:'emerald'},
          {name:'Packing List',status:'ready',icon:'fa-check-circle',color:'emerald'},
          {name:'Bill of Lading',status:'pending',icon:'fa-clock',color:'amber'},
          {name:'Certificate of Origin',status:'missing',icon:'fa-times-circle',color:'red'},
          {name:'Phytosanitary Certificate',status:'missing',icon:'fa-times-circle',color:'red'},
          {name:'Fumigation Certificate',status:'ready',icon:'fa-check-circle',color:'emerald'},
        ];
        const readyCount = docs.filter(d=>d.status==='ready').length;
        const pct = Math.round(readyCount/docs.length*100);
        return `
          <div class="sgtx-card p-5 mb-4">
            <div class="flex items-center justify-between mb-3">
              <div><h3 class="font-semibold text-sm">${t.commodity || 'Import'} <span class="text-surface-400 font-mono text-xs">#${t.id}</span></h3><div class="text-xs text-surface-500">${t.origin_port || '—'} → ${t.destination_port || '—'}</div></div>
              <div class="text-right"><div class="text-2xl font-bold ${pct===100?'text-emerald-600':pct>=50?'text-amber-600':'text-red-600'}">${pct}%</div><div class="text-[10px] text-surface-400">Customs Ready</div></div>
            </div>
            <div class="w-full bg-surface-200 rounded-full h-2 mb-3"><div class="h-2 rounded-full transition-all ${pct===100?'bg-emerald-500':pct>=50?'bg-amber-500':'bg-red-500'}" style="width:${pct}%"></div></div>
            <div class="grid grid-cols-2 gap-2">
              ${docs.map(d => `
                <div class="flex items-center gap-2 p-2 rounded-lg bg-${d.color}-50">
                  <i class="fas ${d.icon} text-${d.color}-500 text-xs"></i>
                  <span class="text-xs text-${d.color}-700 flex-1">${d.name}</span>
                  ${d.status === 'missing' ? `<button onclick="requestDoc('${t.id}','${d.name}')" class="btn-xs bg-${d.color}-100 text-${d.color}-600 px-2">Request</button>` : ''}
                  ${d.status === 'pending' ? '<span class="text-[9px] text-amber-500">In Transit</span>' : ''}
                </div>`).join('')}
            </div>
          </div>`;
      }).join('')}`;
  } catch(e) { content.innerHTML = renderError(e.message); }
}

function requestDoc(tradeId, docName) { showToast('Document requested from seller: ' + docName, 'success'); }

// ─────────────────────────────────────────────────────────────────────────────
// GAP P1-7: CONTRACT SIGNING — Enhanced with upload, AI validation
// ─────────────────────────────────────────────────────────────────────────────
async function renderContractSigningFull() {
  setTitle('Contract Signing', 'Review, upload & sign contracts with Ed25519/QES');
  const content = document.getElementById('content');
  try {
    const res = await api('/contracts?tenant_id=' + (tenant?.id || ''));
    const contracts = res.data || [];
    const pending = contracts.filter(c => c.status === 'PENDING_SIGNATURE' || c.status === 'AWAITING_SIGNATURE');
    const signed = contracts.filter(c => c.status === 'SIGNED' || c.status === 'ACTIVE');

    content.innerHTML = `
      <div class="grid grid-cols-4 gap-4 mb-6">
        ${metricCard('fa-file-signature', 'Pending Signature', pending.length, null, 'amber')}
        ${metricCard('fa-check-double', 'Fully Signed', signed.length, null, 'emerald')}
        ${metricCard('fa-file-contract', 'Total Contracts', contracts.length, null, 'blue')}
        ${metricCard('fa-shield-halved', 'QES Signed', contracts.filter(c=>c.qes_signed).length, null, 'purple')}
      </div>
      <div class="flex gap-2 mb-4">
        <button onclick="showUploadContractModal()" class="bg-white border border-surface-200 text-surface-700 px-4 py-2 rounded-lg text-xs font-medium hover:border-gold-300 transition"><i class="fas fa-upload mr-1"></i>Upload Own Contract</button>
      </div>
      ${contracts.length === 0 ? '<div class="sgtx-card p-8 text-center"><p class="text-surface-500">No contracts. Accept a quote to create a contract.</p></div>' : ''}
      <div class="space-y-3">
        ${contracts.map(c => `
          <div class="sgtx-card p-5">
            <div class="flex items-center justify-between mb-2">
              <div><h3 class="font-semibold">${c.ustn || 'Contract'} <span class="text-xs text-surface-400 font-mono">#${c.id}</span></h3><div class="text-xs text-surface-500">${c.buyer_name || '—'} ↔ ${c.seller_name || '—'} · ${c.incoterm || 'EXW'}</div></div>
              <div class="flex items-center gap-2">${badge(c.status)} <span class="text-xs text-surface-400">${usd(c.total_value || c.invoice_value)}</span></div>
            </div>
            ${c.ai_validation ? `<div class="p-2 bg-blue-50 rounded-lg text-xs text-blue-700 mb-2"><i class="fas fa-robot mr-1"></i>AI Validation: ${c.ai_validation}</div>` : ''}
            <div class="flex gap-2">
              ${c.status === 'PENDING_SIGNATURE' || c.status === 'AWAITING_SIGNATURE' ? `
                <button onclick="signContract('${c.id}')" class="btn-primary text-xs py-1.5 px-4"><i class="fas fa-signature mr-1"></i>Sign with Passkey</button>
                <button onclick="signContractQES('${c.id}')" class="bg-purple-100 text-purple-700 border border-purple-200 px-4 py-1.5 rounded-lg text-xs font-medium"><i class="fas fa-stamp mr-1"></i>QES Sign</button>
              ` : ''}
              <button onclick="viewContractDetail('${c.id}')" class="btn-xs bg-surface-200 text-surface-700">View Details</button>
            </div>
          </div>`).join('')}
      </div>`;
  } catch(e) { content.innerHTML = renderError(e.message); }
}

async function signContract(id) {
  if (!confirm('Sign this contract with Ed25519? This is irrevocable and Loom-anchored.')) return;
  try {
    await apiPost('/contracting/sign', { contract_id: id, signature_type: 'ED25519' });
    showToast('Contract signed successfully', 'success');
    renderContractSigningFull();
  } catch(e) { showToast('Signing failed: ' + e.message, 'error'); }
}

function signContractQES(id) { showToast('QES signing initiated — redirect to Egypt Trust TSP', 'info'); }
function showUploadContractModal() {
  showModal('Upload Contract', '<div class="p-4"><p class="text-xs text-surface-500 mb-3">Upload your own contract document. AI will validate clauses against SGTX governance rules.</p><input type="file" class="w-full mb-3"><button class="btn-primary w-full py-2">Upload & Validate</button></div>');
}
function viewContractDetail(id) { showModal('Contract #' + id, '<div class="p-4 text-sm text-surface-600">Full contract details with clause breakdown, signature status, and Loom verification hash.</div>'); }

// ─────────────────────────────────────────────────────────────────────────────
// GAP P1-8: COMPANY ADMIN — Enhanced with data scopes, approval chains, branding
// ─────────────────────────────────────────────────────────────────────────────
async function renderCompanyAdminFull() {
  setTitle('Company Admin', 'Employees, roles, data scopes, approval chains & branding');
  const content = document.getElementById('content');
  try {
    const emps = (await api('/employees?tenant_id=' + (tenant?.id || ''))).data || [];
    content.innerHTML = `
      <div class="flex gap-2 mb-6">
        ${['employees','roles','scopes','approvals','branding'].map((t,i) => `
          <button onclick="showAdminTab('${t}')" id="admin-tab-${t}" class="py-2 px-4 rounded-lg text-xs font-semibold transition ${i===0 ? 'bg-gold-400 text-white' : 'bg-white text-surface-600 border border-surface-200'}">
            ${['Employees','Roles & Perms','Data Scopes','Approval Chains','Branding'][i]}
          </button>`).join('')}
      </div>
      <div id="admin-content">
        <div class="sgtx-card p-5">
          <div class="flex items-center justify-between mb-3">
            <h3 class="font-semibold text-sm"><i class="fas fa-users mr-2 text-blue-500"></i>Employees (${emps.length})</h3>
            <button onclick="showInviteEmployeeForm()" class="btn-primary text-xs py-1.5 px-3"><i class="fas fa-plus mr-1"></i>Invite</button>
          </div>
          <table class="w-full text-sm"><thead><tr class="text-left text-surface-500 text-xs border-b"><th class="pb-2">Name</th><th class="pb-2">Email</th><th class="pb-2">Role</th><th class="pb-2">Mode</th><th class="pb-2">Status</th><th class="pb-2">Actions</th></tr></thead>
          <tbody>${emps.map(e => `<tr class="border-b border-surface-100 hover:bg-surface-50"><td class="py-2 font-medium">${e.full_name}</td><td class="py-2 text-xs">${e.email}</td><td class="py-2">${e.role || e.role_name || '—'}</td><td class="py-2">${e.active_trader_mode_context || '—'}</td><td class="py-2">${badge(e.status)}</td><td class="py-2"><button class="btn-xs bg-surface-200 text-surface-700">Edit</button></td></tr>`).join('')}</tbody></table>
        </div>
      </div>`;
  } catch(e) { content.innerHTML = renderError(e.message); }
}

function showAdminTab(tab) {
  ['employees','roles','scopes','approvals','branding'].forEach(t => {
    const btn = document.getElementById('admin-tab-'+t);
    if (btn) btn.className = 'py-2 px-4 rounded-lg text-xs font-semibold transition ' + (t === tab ? 'bg-gold-400 text-white' : 'bg-white text-surface-600 border border-surface-200');
  });
  const el = document.getElementById('admin-content');
  if (!el) return;
  if (tab === 'roles') {
    el.innerHTML = '<div class="sgtx-card p-5"><h3 class="font-semibold text-sm mb-3"><i class="fas fa-user-shield mr-2"></i>Roles & Permissions</h3><div class="space-y-2">' +
      ['Admin','Trade Manager','Viewer','Finance'].map(r => `<div class="p-3 bg-surface-50 rounded-lg flex items-center justify-between"><span class="font-medium text-sm">${r}</span><button class="btn-xs bg-surface-200 text-surface-700">Configure</button></div>`).join('') + '</div></div>';
  } else if (tab === 'scopes') {
    el.innerHTML = '<div class="sgtx-card p-5"><h3 class="font-semibold text-sm mb-3"><i class="fas fa-eye mr-2"></i>Data Scopes (Part 2.4)</h3><p class="text-xs text-surface-500 mb-3">Control which data each employee can access based on their role and department.</p><div class="space-y-2"><div class="p-3 bg-surface-50 rounded-lg flex items-center justify-between"><div><span class="font-medium text-sm">Allow Role Switching</span><div class="text-xs text-surface-400">Allow DUAL-mode employees to switch between buyer/seller views</div></div><label class="relative inline-flex items-center cursor-pointer"><input type="checkbox" checked class="sr-only peer"><div class="w-9 h-5 bg-surface-200 peer-checked:bg-gold-400 rounded-full peer peer-checked:after:translate-x-full after:content-[\'\'] after:absolute after:top-0.5 after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all"></div></label></div></div></div>';
  } else if (tab === 'approvals') {
    el.innerHTML = '<div class="sgtx-card p-5"><h3 class="font-semibold text-sm mb-3"><i class="fas fa-route mr-2"></i>Approval Chains (Part 2.4)</h3><p class="text-xs text-surface-500 mb-3">Define multi-level approval workflows for high-value actions.</p><div class="p-3 bg-amber-50 border border-amber-200 rounded-lg mb-3"><div class="text-sm font-medium text-amber-800">Contract Signing > $100,000</div><div class="text-xs text-amber-600">Requires: 2× Trade Manager + 1× Finance Approver (Parallel)</div></div><button class="btn-primary text-xs py-1.5 px-3"><i class="fas fa-plus mr-1"></i>Add Policy</button></div>';
  } else if (tab === 'branding') {
    el.innerHTML = '<div class="sgtx-card p-5"><h3 class="font-semibold text-sm mb-3"><i class="fas fa-palette mr-2"></i>Organization Branding</h3><div class="grid grid-cols-2 gap-4"><div><label class="text-xs text-surface-500">Company Logo URL</label><input type="text" class="w-full" placeholder="https://..."></div><div><label class="text-xs text-surface-500">Primary Color</label><input type="color" class="w-full h-10" value="#D4A017"></div></div><button class="btn-primary text-xs py-2 px-4 mt-4">Save Branding</button></div>';
  } else {
    renderCompanyAdminFull();
  }
}

