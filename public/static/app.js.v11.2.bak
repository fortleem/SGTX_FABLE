              <i class="fas fa-shirt text-surface-500 text-4xl"></i>
            </div>
          </div>
          <!-- Defect bounding box -->
          <div class="absolute top-12 right-16 w-16 h-12 border-2 border-red-500 rounded bg-red-500/10">
