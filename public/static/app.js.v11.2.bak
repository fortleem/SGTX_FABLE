if (typeof pageRenderers !== 'undefined') {
  pageRenderers['quote-review'] = renderQuoteReviewFull;
  pageRenderers['exw-price-lock'] = renderEXWPriceLockFull;
  pageRenderers['containerisation'] = renderContainerisationFull;
  pageRenderers['logistics-builder'] = renderLogisticsBuilderFull;
  pageRenderers['doc-finalisation'] = renderDocFinalisationFull;
  pageRenderers['barcode-print'] = renderBarcodePrintFull;
  pageRenderers['cash-position'] = renderCashPositionFull;
  pageRenderers['financing'] = renderFinancingFull;
  pageRenderers['customs-readiness'] = renderCustomsReadinessFull;
  pageRenderers['contract-signing'] = renderContractSigningFull;
  pageRenderers['company-admin'] = renderCompanyAdminFull;
}

