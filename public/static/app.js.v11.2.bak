// ─────────────────────────────────────────────────────────────────────────────
// 1. LABORATORY SELECTION (Blueprint 12C.2 Tab 7)
// Complete seller tab for selecting accredited laboratories for pre-shipment testing
// ─────────────────────────────────────────────────────────────────────────────
async function renderLabSelection() {
  setTitle('Laboratory Selection', 'Select accredited labs for pre-shipment testing — Blueprint 12C.2 Tab 7');
  const content = document.getElementById('content');

  // Load labs and bookings
  let labs = [], bookings = [], testTypes = [];
  try {
    const [labsRes, bookingsRes, ttRes] = await Promise.all([
      api('/laboratories?verified_only=1'),
      api('/lab-bookings?tenant_id=' + tenant?.id),
      api('/lab-test-types'),
    ]);
    labs = labsRes.data || [];
    bookings = bookingsRes.data || [];
    testTypes = ttRes.data || [];
  } catch(e) {}

  const statusColors = { PENDING: 'warning', CONFIRMED: 'info', SAMPLE_RECEIVED: 'info', IN_PROGRESS: 'purple', COMPLETED: 'success', CANCELLED: 'danger' };
  const tierIcons = { BUDGET: 'fa-tag', STANDARD: 'fa-star-half-stroke', PREMIUM: 'fa-crown' };
  const tierColors = { BUDGET: 'emerald', STANDARD: 'blue', PREMIUM: 'amber' };

  content.innerHTML = `
    <div class="space-y-6">
      <!-- Active Bookings -->
      <div class="sgtx-card p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-bold"><i class="fas fa-flask text-gold-400 mr-2"></i>My Lab Bookings</h2>
          <button onclick="showLabBookingForm()" class="btn-primary text-xs"><i class="fas fa-plus mr-1"></i>New Booking</button>
        </div>
        ${bookings.length === 0 ? '<div class="text-center py-8 text-surface-400"><i class="fas fa-vial text-3xl mb-3 block"></i>No lab bookings yet. Select a lab below to create your first booking.</div>' :
        `<div class="overflow-x-auto"><table class="sgtx-table"><thead><tr>
          <th>Lab</th><th>Commodity</th><th>Tests</th><th>Priority</th><th>Est. Completion</th><th>Cost</th><th>Status</th><th></th>
        </tr></thead><tbody>
          ${bookings.map(b => `<tr>
            <td><div class="font-semibold text-sm">${b.lab_name || '—'}</div><div class="text-[10px] text-surface-400">${b.lab_country || ''} · ${b.lab_accreditation || ''}</div></td>
            <td>${b.commodity_type || b.product_name || '—'}</td>
            <td><span class="badge badge-info">${(b.test_types || []).length} test(s)</span></td>
            <td><span class="badge ${b.priority === 'RUSH' ? 'badge-warning' : b.priority === 'EXPRESS' ? 'badge-danger' : 'badge-neutral'}">${b.priority}</span></td>
            <td class="text-xs">${b.estimated_completion ? new Date(b.estimated_completion).toLocaleDateString() : '—'}</td>
            <td class="font-semibold">${b.cost_estimate ? '$' + b.cost_estimate.toLocaleString() : '—'}</td>
            <td>${badge(b.status)}</td>
            <td><button onclick="showLabBookingDetail('${b.id}')" class="text-gold-400 hover:text-gold-400 text-xs"><i class="fas fa-eye"></i></button></td>
          </tr>`).join('')}
        </tbody></table></div>`}
      </div>

      <!-- Lab Directory -->
      <div class="sgtx-card p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-bold"><i class="fas fa-building text-blue-500 mr-2"></i>Accredited Laboratory Directory</h2>
          <div class="flex gap-2">
            <select id="lab-filter-country" onchange="filterLabs()" class="text-xs px-3 py-1.5 rounded-lg">
              <option value="">All Countries</option>
              ${[...new Set(labs.map(l => l.country_code))].sort().map(cc => `<option value="${cc}">${cc}</option>`).join('')}
            </select>
            <select id="lab-filter-tier" onchange="filterLabs()" class="text-xs px-3 py-1.5 rounded-lg">
              <option value="">All Tiers</option>
              <option value="BUDGET">Budget</option>
              <option value="STANDARD">Standard</option>
              <option value="PREMIUM">Premium</option>
            </select>
            <input type="text" id="lab-search" placeholder="Search labs..." oninput="filterLabs()" class="text-xs px-3 py-1.5 rounded-lg w-40">
          </div>
        </div>
        <div id="lab-directory-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          ${labs.map(lab => renderLabCard(lab)).join('')}
        </div>
      </div>

      <!-- Test Types Reference -->
      <div class="sgtx-card p-6">
        <h2 class="text-lg font-bold mb-4"><i class="fas fa-list-check text-emerald-500 mr-2"></i>Available Test Types</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
          ${testTypes.map(tt => `
            <div class="p-3 rounded-lg border border-surface-200 hover:border-gold-300 transition">
              <div class="flex items-center justify-between mb-1">
                <span class="font-semibold text-sm">${tt.name}</span>
                <span class="badge ${tt.is_mandatory ? 'badge-danger' : 'badge-neutral'}">${tt.is_mandatory ? 'MANDATORY' : 'OPTIONAL'}</span>
              </div>
              <div class="text-xs text-surface-400 mb-2">${tt.description || ''}</div>
              <div class="flex items-center justify-between text-[11px]">
                <span class="text-surface-500"><i class="fas fa-clock mr-1"></i>${tt.typical_duration_days}d</span>
                <span class="text-surface-500"><i class="fas fa-tag mr-1"></i>~$${tt.typical_cost_usd || '—'}</span>
                <span class="badge badge-info text-[9px]">${tt.category}</span>
              </div>
            </div>
          `).join('')}
        </div>
      </div>
    </div>`;

  // Store for filtering
  window._labData = labs;
}

function renderLabCard(lab) {
  const tierColors = { BUDGET: 'emerald', STANDARD: 'blue', PREMIUM: 'amber' };
  const tierIcons = { BUDGET: 'fa-tag', STANDARD: 'fa-star-half-stroke', PREMIUM: 'fa-crown' };
  const tc = tierColors[lab.price_tier] || 'blue';
  const ti = tierIcons[lab.price_tier] || 'fa-star';
  const specs = (lab.specialisations || []).slice(0, 3);
  const caps = (lab.testing_capabilities || []);
  const stars = '★'.repeat(Math.floor(lab.rating || 0)) + (lab.rating % 1 >= 0.5 ? '½' : '');

  return `<div class="p-4 rounded-xl border border-surface-200 hover:border-gold-300 hover:shadow-card-hover transition group cursor-pointer" onclick="showLabDetail('${lab.id}')">
    <div class="flex items-start justify-between mb-2">
      <div>
        <div class="font-bold text-sm group-hover:text-gold-400 transition">${lab.name}</div>
        <div class="text-[10px] text-surface-400"><i class="fas fa-map-marker-alt mr-1"></i>${lab.city || ''}, ${lab.country_code}</div>
      </div>
      <div class="flex items-center gap-1">
        ${lab.sgtx_verified ? '<span class="badge badge-success text-[9px]"><i class="fas fa-shield-check mr-0.5"></i>Verified</span>' : ''}
        <span class="badge badge-${tc === 'amber' ? 'warning' : tc === 'emerald' ? 'success' : 'info'} text-[9px]"><i class="fas ${ti} mr-0.5"></i>${lab.price_tier}</span>
      </div>
    </div>
    <div class="text-xs text-surface-500 mb-2"><i class="fas fa-certificate mr-1 text-amber-500"></i>${lab.accreditation || 'N/A'}</div>
    <div class="flex flex-wrap gap-1 mb-2">${specs.map(s => `<span class="px-2 py-0.5 rounded-full bg-gold-50 text-gold-400 text-[9px] font-medium">${s}</span>`).join('')}</div>
    <div class="flex items-center justify-between text-[10px] text-surface-400">
      <span class="text-amber-500 font-semibold">${stars} ${lab.rating?.toFixed(1) || '—'}</span>
      <span><i class="fas fa-clock mr-0.5"></i>${lab.turnaround_days || '?'}d turnaround</span>
      <span>${lab.rush_available ? '<i class="fas fa-bolt text-amber-500 mr-0.5"></i>Rush' : ''}</span>
    </div>
    <button class="mt-3 w-full btn-primary text-xs py-1.5" onclick="event.stopPropagation(); selectLabForBooking('${lab.id}', '${(lab.name || '').replace(/'/g, "\\'")}')">
      <i class="fas fa-calendar-check mr-1"></i>Book This Lab
    </button>
  </div>`;
}

function filterLabs() {
  const country = document.getElementById('lab-filter-country')?.value || '';
  const tier = document.getElementById('lab-filter-tier')?.value || '';
  const search = (document.getElementById('lab-search')?.value || '').toLowerCase();
  const labs = window._labData || [];
  const filtered = labs.filter(l => {
    if (country && l.country_code !== country) return false;
    if (tier && l.price_tier !== tier) return false;
    if (search && !l.name.toLowerCase().includes(search) && !(l.city || '').toLowerCase().includes(search)) return false;
    return true;
  });
  const grid = document.getElementById('lab-directory-grid');
  if (grid) grid.innerHTML = filtered.length ? filtered.map(l => renderLabCard(l)).join('') : '<div class="col-span-3 text-center py-8 text-surface-400">No labs match your filters</div>';
}

async function showLabDetail(labId) {
  try {
    const r = await api('/laboratories/' + labId);
    const lab = r.data;
    if (!lab) return;
    const caps = lab.testing_capabilities || [];
    const specs = lab.specialisations || [];
    showModal(`<div class="flex items-center gap-3 mb-1"><i class="fas fa-flask text-gold-400 text-xl"></i><div><div class="text-lg font-bold">${lab.name}</div><div class="text-xs text-surface-400">${lab.city}, ${lab.country_code}</div></div></div>`,
      `<div class="space-y-4">
        <div class="grid grid-cols-3 gap-4">
          ${metricCard('fa-certificate', 'Accreditation', lab.accreditation || 'N/A', '', 'amber')}
          ${metricCard('fa-star', 'Rating', (lab.rating || 0).toFixed(1) + '/5.0', lab.total_reviews + ' reviews', 'amber')}
          ${metricCard('fa-clock', 'Turnaround', lab.turnaround_days + ' days', lab.rush_available ? 'Rush available' : 'Standard only', 'blue')}
        </div>
        <div class="sgtx-card p-4"><h4 class="font-semibold mb-2">Specialisations</h4><div class="flex flex-wrap gap-2">${specs.map(s => `<span class="badge badge-info">${s}</span>`).join('')}</div></div>
        <div class="sgtx-card p-4"><h4 class="font-semibold mb-2">Testing Capabilities</h4><div class="flex flex-wrap gap-2">${caps.map(c => `<span class="badge badge-gold">${c}</span>`).join('')}</div></div>
        ${lab.contact_email ? `<div class="text-sm"><i class="fas fa-envelope mr-2 text-surface-400"></i>${lab.contact_email}</div>` : ''}
        ${lab.website ? `<div class="text-sm"><i class="fas fa-globe mr-2 text-surface-400"></i>${lab.website}</div>` : ''}
        <button onclick="selectLabForBooking('${lab.id}', '${(lab.name || '').replace(/'/g, "\\'")}'); closeModal();" class="btn-primary w-full"><i class="fas fa-calendar-check mr-2"></i>Book This Laboratory</button>
      </div>`);
  } catch(e) { showToast('Failed to load lab details', 'error'); }
}

async function selectLabForBooking(labId, labName) {
  // Load test types for selection
  let testTypes = [];
  try { const r = await api('/lab-test-types'); testTypes = r.data || []; } catch {}

  const categories = [...new Set(testTypes.map(t => t.category))];

  showModal(`<div class="flex items-center gap-3"><i class="fas fa-calendar-plus text-emerald-500 text-xl"></i><div><div class="text-lg font-bold">Book Laboratory Test</div><div class="text-xs text-surface-400">${labName}</div></div></div>`,
    `<div class="space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div><label class="text-xs font-medium text-surface-500 mb-1 block">Commodity Type</label>
          <select id="lb-commodity" class="w-full"><option value="">Select commodity...</option>
            ${['Fresh Produce','Grains & Cereals','Coffee & Cocoa','Spices','Seafood','Textiles','Chemicals','Metals','Processed Foods','Tea','Nuts & Seeds','Dairy','Meat'].map(c => `<option value="${c}">${c}</option>`).join('')}
          </select></div>
        <div><label class="text-xs font-medium text-surface-500 mb-1 block">Product Name</label>
          <input type="text" id="lb-product" placeholder="e.g. Arabica Green Beans"></div>
      </div>
      <div><label class="text-xs font-medium text-surface-500 mb-1 block">Select Tests</label>
        <div class="grid grid-cols-2 gap-2 max-h-48 overflow-y-auto border border-surface-200 rounded-lg p-3">
          ${testTypes.map(tt => `<label class="flex items-start gap-2 cursor-pointer p-1.5 rounded hover:bg-surface-50">
            <input type="checkbox" class="mt-0.5 lb-test-check" value="${tt.id}" data-cost="${tt.typical_cost_usd || 0}">
            <div><div class="text-xs font-medium">${tt.name}</div><div class="text-[10px] text-surface-400">${tt.category} · ~$${tt.typical_cost_usd || '?'} · ${tt.typical_duration_days}d ${tt.is_mandatory ? '<span class="text-red-500 font-bold">*</span>' : ''}</div></div>
          </label>`).join('')}
        </div>
      </div>
      <div class="grid grid-cols-3 gap-4">
        <div><label class="text-xs font-medium text-surface-500 mb-1 block">Samples</label>
          <input type="number" id="lb-samples" value="1" min="1" max="50"></div>
        <div><label class="text-xs font-medium text-surface-500 mb-1 block">Priority</label>
          <select id="lb-priority"><option value="STANDARD">Standard</option><option value="RUSH">Rush (+50%)</option><option value="EXPRESS">Express (+100%)</option></select></div>
        <div><label class="text-xs font-medium text-surface-500 mb-1 block">Preferred Date</label>
          <input type="date" id="lb-date"></div>
      </div>
      <div><label class="text-xs font-medium text-surface-500 mb-1 block">Notes</label>
        <textarea id="lb-notes" rows="2" placeholder="Special instructions..."></textarea></div>
      <div id="lb-cost-preview" class="p-3 rounded-lg bg-gold-50 border border-gold-200 text-sm font-medium text-gold-400">
        <i class="fas fa-calculator mr-1"></i>Select tests to see estimated cost
      </div>
      <button onclick="submitLabBooking('${labId}')" class="btn-success w-full text-sm"><i class="fas fa-check mr-2"></i>Submit Booking</button>
    </div>`);

  // Cost preview updates
  document.querySelectorAll('.lb-test-check').forEach(cb => {
    cb.addEventListener('change', () => {
      const checked = document.querySelectorAll('.lb-test-check:checked');
      let cost = 0;
      checked.forEach(c => { cost += parseFloat(c.dataset.cost || '0'); });
      const priority = document.getElementById('lb-priority')?.value || 'STANDARD';
      if (priority === 'RUSH') cost *= 1.5;
      if (priority === 'EXPRESS') cost *= 2.0;
      const samples = parseInt(document.getElementById('lb-samples')?.value || '1');
      cost *= samples;
      document.getElementById('lb-cost-preview').innerHTML = `<i class="fas fa-calculator mr-1"></i>Estimated cost: <span class="font-bold text-gold-400">$${cost.toLocaleString()}</span> (${checked.length} test(s), ${priority.toLowerCase()}, ${samples} sample(s))`;
    });
  });
}

async function submitLabBooking(labId) {
  const testChecks = document.querySelectorAll('.lb-test-check:checked');
  const testIds = Array.from(testChecks).map(c => c.value);
  if (testIds.length === 0) { showToast('Please select at least one test', 'error'); return; }

  const payload = {
    tenant_id: tenant?.id,
    laboratory_id: labId,
    commodity_type: document.getElementById('lb-commodity')?.value || '',
    product_name: document.getElementById('lb-product')?.value || '',
    test_types: testIds,
    sample_count: parseInt(document.getElementById('lb-samples')?.value || '1'),
    priority: document.getElementById('lb-priority')?.value || 'STANDARD',
    requested_date: document.getElementById('lb-date')?.value || null,
    notes: document.getElementById('lb-notes')?.value || '',
  };

  try {
    const r = await apiPost('/lab-bookings', payload);
    if (r.success) {
      closeModal();
      showToast(`Lab booking created! Est. cost: $${r.cost_estimate?.toLocaleString() || '—'}, completion: ${r.estimated_completion ? new Date(r.estimated_completion).toLocaleDateString() : '—'}`, 'success');
      renderLabSelection();
    } else { showToast(r.error || 'Booking failed', 'error'); }
  } catch(e) { showToast('Booking failed: ' + e.message, 'error'); }
}

function showLabBookingForm() {
  // Show the lab directory with booking focus
  showToast('Select a laboratory from the directory below to create a booking', 'info');
  document.getElementById('lab-directory-grid')?.scrollIntoView({ behavior: 'smooth' });
}

function showLabBookingDetail(bookingId) {
  showToast('Loading booking details...', 'info');
  // Could show modal with full booking detail — simplified for now
}


// ─────────────────────────────────────────────────────────────────────────────
// 2. GOVERNMENT PERMIT ISSUANCE (Blueprint 6.2.6)
// ─────────────────────────────────────────────────────────────────────────────
async function renderGovPermits() {
  setTitle('Permit Issuance', 'Issue, review, and track import/export permits — Blueprint 6.2.6');
  const content = document.getElementById('content');

  let permits = [], stats = {};
  try {
    const r = await api('/gov/permits?country_code=' + (tenant?.jurisdiction || ''));
    permits = r.data || [];
    stats = r.stats || {};
  } catch(e) {}

  const typeLabels = {
    IMPORT_LICENSE: { icon: 'fa-file-import', color: 'blue', label: 'Import License' },
    EXPORT_LICENSE: { icon: 'fa-file-export', color: 'emerald', label: 'Export License' },
    PHYTOSANITARY: { icon: 'fa-leaf', color: 'green', label: 'Phytosanitary' },
    HEALTH_CERTIFICATE: { icon: 'fa-heart-pulse', color: 'rose', label: 'Health Certificate' },
    ORIGIN_CERTIFICATE: { icon: 'fa-flag', color: 'amber', label: 'Certificate of Origin' },
    FUMIGATION: { icon: 'fa-spray-can', color: 'purple', label: 'Fumigation' },
    HALAL: { icon: 'fa-moon', color: 'emerald', label: 'Halal' },
    ORGANIC: { icon: 'fa-seedling', color: 'green', label: 'Organic' },
    SPECIAL_HANDLING: { icon: 'fa-hand', color: 'amber', label: 'Special Handling' },
  };

  content.innerHTML = `
    <div class="space-y-6">
      <!-- Stats -->
      <div class="grid grid-cols-4 gap-4">
        ${metricCard('fa-file-circle-check', 'Total Permits', stats.total || 0, '', 'gold')}
        ${metricCard('fa-check-circle', 'Approved', stats.approved || 0, '', 'emerald')}
        ${metricCard('fa-clock', 'Pending Review', stats.pending || 0, '', 'amber')}
        ${metricCard('fa-times-circle', 'Rejected', stats.rejected || 0, '', 'rose')}
      </div>

      <!-- Actions Bar -->
      <div class="sgtx-card p-4 flex items-center justify-between">
        <div class="flex gap-2">
          <select id="permit-filter-status" onchange="filterPermits()" class="text-xs px-3 py-1.5 rounded-lg">
            <option value="">All Statuses</option>
            <option value="SUBMITTED">Submitted</option>
            <option value="UNDER_REVIEW">Under Review</option>
            <option value="APPROVED">Approved</option>
            <option value="REJECTED">Rejected</option>
          </select>
          <select id="permit-filter-type" onchange="filterPermits()" class="text-xs px-3 py-1.5 rounded-lg">
            <option value="">All Types</option>
            ${Object.entries(typeLabels).map(([k, v]) => `<option value="${k}">${v.label}</option>`).join('')}
          </select>
        </div>
        <button onclick="showCreatePermitForm()" class="btn-primary text-xs"><i class="fas fa-plus mr-1"></i>New Permit Application</button>
      </div>

      <!-- Permits Table -->
      <div class="sgtx-card p-6">
        <div id="permits-table-body">
          ${permits.length === 0 ? '<div class="text-center py-10 text-surface-400"><i class="fas fa-stamp text-4xl mb-3 block"></i>No permits found</div>' :
          `<div class="overflow-x-auto"><table class="sgtx-table"><thead><tr>
            <th>Type</th><th>USTN</th><th>Applicant</th><th>Agency</th><th>Country</th><th>Commodity</th><th>Priority</th><th>Status</th><th>Permit #</th><th>Actions</th>
          </tr></thead><tbody>
            ${permits.map(p => {
              const t = typeLabels[p.permit_type] || { icon: 'fa-file', color: 'surface', label: p.permit_type };
              return `<tr class="permit-row" data-status="${p.status}" data-type="${p.permit_type}">
                <td><span class="inline-flex items-center gap-1.5"><i class="fas ${t.icon} text-${t.color}-500"></i><span class="text-xs font-medium">${t.label}</span></span></td>
                <td class="text-xs font-mono">${p.ustn || '—'}</td>
                <td class="text-xs">${p.applicant_tenant_id?.slice(0, 12) || '—'}</td>
                <td class="text-xs font-semibold">${p.reviewing_agency || '—'}</td>
                <td><span class="badge badge-neutral">${p.country_code}</span></td>
                <td class="text-xs">${p.commodity_type || '—'}</td>
                <td><span class="badge ${p.priority === 'URGENT' ? 'badge-danger' : p.priority === 'EXPEDITED' ? 'badge-warning' : 'badge-neutral'}">${p.priority}</span></td>
                <td>${badge(p.status)}</td>
                <td class="text-xs font-mono">${p.permit_number || '<span class="text-surface-300">Pending</span>'}</td>
                <td class="flex gap-1">
                  ${p.status === 'SUBMITTED' || p.status === 'UNDER_REVIEW' ? `<button onclick="autoApprovePermit('${p.id}')" class="text-emerald-500 hover:text-emerald-700 text-xs" title="AI Auto-Clear"><i class="fas fa-robot"></i></button>` : ''}
                  ${p.status === 'SUBMITTED' ? `<button onclick="reviewPermit('${p.id}', 'APPROVED')" class="text-emerald-500 hover:text-emerald-700 text-xs" title="Approve"><i class="fas fa-check"></i></button>` : ''}
                  ${p.status === 'SUBMITTED' ? `<button onclick="reviewPermit('${p.id}', 'REJECTED')" class="text-red-500 hover:text-red-700 text-xs" title="Reject"><i class="fas fa-times"></i></button>` : ''}
                  <button onclick="showPermitDetail('${p.id}')" class="text-gold-400 hover:text-gold-400 text-xs" title="Details"><i class="fas fa-eye"></i></button>
                </td>
              </tr>`;
            }).join('')}
          </tbody></table></div>`}
        </div>
      </div>
    </div>`;

  window._permitData = permits;
}

function filterPermits() {
  const status = document.getElementById('permit-filter-status')?.value || '';
  const type = document.getElementById('permit-filter-type')?.value || '';
  document.querySelectorAll('.permit-row').forEach(row => {
    const rs = row.dataset.status;
    const rt = row.dataset.type;
    const show = (!status || rs === status) && (!type || rt === type);
    row.style.display = show ? '' : 'none';
  });
}

function showCreatePermitForm() {
  showModal('<div class="text-lg font-bold"><i class="fas fa-stamp text-gold-400 mr-2"></i>New Permit Application</div>',
    `<div class="space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div><label class="text-xs font-medium mb-1 block">Permit Type *</label>
          <select id="np-type"><option value="IMPORT_LICENSE">Import License</option><option value="EXPORT_LICENSE">Export License</option><option value="PHYTOSANITARY">Phytosanitary</option><option value="HEALTH_CERTIFICATE">Health Certificate</option><option value="ORIGIN_CERTIFICATE">Certificate of Origin</option><option value="HALAL">Halal Certification</option><option value="FUMIGATION">Fumigation</option><option value="ORGANIC">Organic</option></select></div>
        <div><label class="text-xs font-medium mb-1 block">Country *</label>
          <select id="np-country"><option value="EG">Egypt</option><option value="US">United States</option><option value="DE">Germany</option><option value="SA">Saudi Arabia</option><option value="VN">Vietnam</option><option value="CN">China</option><option value="IN">India</option><option value="BR">Brazil</option></select></div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div><label class="text-xs font-medium mb-1 block">Reviewing Agency</label>
          <input type="text" id="np-agency" placeholder="e.g. APHIS, NAFEZA, SFDA"></div>
        <div><label class="text-xs font-medium mb-1 block">Commodity</label>
          <input type="text" id="np-commodity" placeholder="e.g. Fresh Produce"></div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div><label class="text-xs font-medium mb-1 block">HS Code</label>
          <input type="text" id="np-hs" placeholder="e.g. 080510"></div>
        <div><label class="text-xs font-medium mb-1 block">Priority</label>
          <select id="np-priority"><option value="NORMAL">Normal</option><option value="EXPEDITED">Expedited</option><option value="URGENT">Urgent</option></select></div>
      </div>
      <div><label class="text-xs font-medium mb-1 block">USTN (if applicable)</label>
        <input type="text" id="np-ustn" placeholder="USTN-..."></div>
      <div><label class="text-xs font-medium mb-1 block">Notes</label>
        <textarea id="np-notes" rows="2" placeholder="Additional information..."></textarea></div>
      <button onclick="submitPermitApplication()" class="btn-primary w-full"><i class="fas fa-paper-plane mr-2"></i>Submit Application</button>
    </div>`);
}

async function submitPermitApplication() {
  const payload = {
    permit_type: document.getElementById('np-type')?.value,
    applicant_tenant_id: tenant?.id,
    country_code: document.getElementById('np-country')?.value,
    reviewing_agency: document.getElementById('np-agency')?.value || null,
    commodity_type: document.getElementById('np-commodity')?.value || null,
    hs_code: document.getElementById('np-hs')?.value || null,
    priority: document.getElementById('np-priority')?.value || 'NORMAL',
    ustn: document.getElementById('np-ustn')?.value || null,
    notes: document.getElementById('np-notes')?.value || '',
  };
  try {
    const r = await apiPost('/gov/permits', payload);
    if (r.success) { closeModal(); showToast('Permit application submitted', 'success'); renderGovPermits(); }
    else showToast(r.error || 'Failed', 'error');
  } catch(e) { showToast('Error: ' + e.message, 'error'); }
}

async function autoApprovePermit(id) {
  try {
    const r = await apiPost('/gov/permits/' + id + '/auto-clear', {});
    if (r.auto_cleared) showToast('Permit auto-cleared by AI! Permit #: ' + r.permit_number, 'success');
    else showToast('Auto-clear denied — manual review required (' + (r.blocking_rules || 0) + ' blocking rules)', 'info');
    renderGovPermits();
  } catch(e) { showToast('Auto-clear failed', 'error'); }
}

async function reviewPermit(id, newStatus) {
  const reason = newStatus === 'REJECTED' ? prompt('Rejection reason:') : null;
  if (newStatus === 'REJECTED' && !reason) return;
  try {
    const body = { status: newStatus };
    if (reason) body.rejection_reason = reason;
    if (newStatus === 'APPROVED') body.permit_number = 'MANUAL-' + Date.now().toString(36).toUpperCase();
    await apiPatch('/gov/permits/' + id, body);
    showToast(`Permit ${newStatus.toLowerCase()}`, 'success');
    renderGovPermits();
  } catch(e) { showToast('Update failed', 'error'); }
}

async function showPermitDetail(id) {
  try {
    const r = await api('/gov/permits/' + id);
    const p = r.data;
    if (!p) return;
    showModal(`<div class="text-lg font-bold"><i class="fas fa-file-circle-check text-gold-400 mr-2"></i>Permit Detail</div>`,
      `<div class="space-y-3">
        <div class="grid grid-cols-2 gap-3 text-sm">
          <div><span class="text-surface-400">Type:</span> <strong>${p.permit_type}</strong></div>
          <div><span class="text-surface-400">Status:</span> ${badge(p.status)}</div>
          <div><span class="text-surface-400">Country:</span> ${p.country_code}</div>
          <div><span class="text-surface-400">Agency:</span> ${p.reviewing_agency || '—'}</div>
          <div><span class="text-surface-400">Commodity:</span> ${p.commodity_type || '—'}</div>
          <div><span class="text-surface-400">HS Code:</span> ${p.hs_code || '—'}</div>
          <div><span class="text-surface-400">Priority:</span> ${p.priority}</div>
          <div><span class="text-surface-400">Permit #:</span> <span class="font-mono">${p.permit_number || 'Pending'}</span></div>
          <div><span class="text-surface-400">Submitted:</span> ${time(p.submitted_at)}</div>
          <div><span class="text-surface-400">Reviewed:</span> ${time(p.reviewed_at)}</div>
          <div><span class="text-surface-400">Approved:</span> ${time(p.approved_at)}</div>
          <div><span class="text-surface-400">Expires:</span> ${time(p.expires_at)}</div>
        </div>
        ${p.auto_approved ? '<div class="badge badge-success"><i class="fas fa-robot mr-1"></i>Auto-approved by SGTX AI</div>' : ''}
        ${p.rejection_reason ? `<div class="p-3 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm"><i class="fas fa-times-circle mr-1"></i>${p.rejection_reason}</div>` : ''}
        ${(p.conditions || []).length > 0 ? `<div class="p-3 rounded-lg bg-amber-50 border border-amber-200"><h4 class="font-semibold text-amber-800 mb-1">Conditions</h4><ul class="text-sm text-amber-700 list-disc pl-4">${p.conditions.map(c => `<li>${c}</li>`).join('')}</ul></div>` : ''}
      </div>`);
  } catch(e) { showToast('Failed to load permit', 'error'); }
}


// ─────────────────────────────────────────────────────────────────────────────
// 3. GOVERNMENT COMPLIANCE MONITOR (Blueprint 6.2.6)
// ─────────────────────────────────────────────────────────────────────────────
async function renderGovCompliance() {
  setTitle('Compliance Monitor', 'Monitor trade compliance across jurisdictions — Blueprint 6.2.6');
  const content = document.getElementById('content');

  let rules = [], checks = [];
  const country = tenant?.jurisdiction || 'EG';
  try {
    const [rulesRes, checksRes] = await Promise.all([
      api('/gov/compliance-rules?country_code=' + country),
      api('/gov/compliance-checks?tenant_id=' + (tenant?.id || '')),
    ]);
    rules = rulesRes.data || [];
    checks = checksRes.data || [];
  } catch(e) {}

  const passCount = checks.filter(c => c.check_result === 'PASS').length;
  const warnCount = checks.filter(c => c.check_result === 'WARNING').length;
  const failCount = checks.filter(c => c.check_result === 'FAIL').length;

  const severityColors = { REQUIRED: 'danger', RECOMMENDED: 'warning', ADVISORY: 'info' };
  const resultColors = { PASS: 'success', FAIL: 'danger', WARNING: 'warning', PENDING: 'neutral', EXEMPTED: 'info' };
  const typeIcons = { DOCUMENT_REQUIREMENT: 'fa-file-circle-check', THRESHOLD_CHECK: 'fa-ruler-combined', EMBARGO: 'fa-ban', QUOTA: 'fa-chart-bar', LABELING: 'fa-tag', TESTING: 'fa-flask', CERTIFICATION: 'fa-certificate' };

  content.innerHTML = `
    <div class="space-y-6">
      <!-- Compliance Overview -->
      <div class="grid grid-cols-4 gap-4">
        ${metricCard('fa-shield-halved', 'Active Rules', rules.length, country + ' jurisdiction', 'sgtx')}
        ${metricCard('fa-check-double', 'Checks Passed', passCount, '', 'emerald')}
        ${metricCard('fa-exclamation-triangle', 'Warnings', warnCount, '', 'amber')}
        ${metricCard('fa-times-circle', 'Failed', failCount, '', 'rose')}
      </div>

      <!-- Quick Compliance Check -->
      <div class="sgtx-card p-6">
        <h2 class="text-lg font-bold mb-4"><i class="fas fa-search text-gold-400 mr-2"></i>Run Compliance Check</h2>
        <div class="grid grid-cols-4 gap-4">
          <div><label class="text-xs font-medium mb-1 block">Destination Country</label>
            <select id="cc-dest"><option value="EG">Egypt</option><option value="US">United States</option><option value="DE">Germany</option><option value="SA">Saudi Arabia</option><option value="CN">China</option><option value="IN">India</option><option value="VN">Vietnam</option></select></div>
          <div><label class="text-xs font-medium mb-1 block">Commodity</label>
            <select id="cc-commodity"><option value="Fresh Produce">Fresh Produce</option><option value="Grains & Cereals">Grains & Cereals</option><option value="Seafood">Seafood</option><option value="Processed Foods">Processed Foods</option><option value="Spices">Spices</option><option value="Coffee & Cocoa">Coffee & Cocoa</option><option value="Meat">Meat</option><option value="Dairy">Dairy</option></select></div>
          <div><label class="text-xs font-medium mb-1 block">HS Code (optional)</label>
            <input type="text" id="cc-hs" placeholder="e.g. 080510"></div>
          <div class="flex items-end"><button onclick="runComplianceCheck()" class="btn-primary w-full"><i class="fas fa-shield-halved mr-1"></i>Check</button></div>
        </div>
        <div id="cc-results" class="mt-4"></div>
      </div>

      <!-- Active Compliance Rules -->
      <div class="sgtx-card p-6">
        <h2 class="text-lg font-bold mb-4"><i class="fas fa-list-check text-blue-500 mr-2"></i>Active Compliance Rules (${country})</h2>
        <div class="overflow-x-auto"><table class="sgtx-table"><thead><tr>
          <th>Code</th><th>Type</th><th>Title</th><th>Commodities</th><th>Severity</th><th>Action</th>
        </tr></thead><tbody>
          ${rules.map(r => `<tr>
            <td class="font-mono text-xs">${r.rule_code}</td>
            <td><span class="inline-flex items-center gap-1"><i class="fas ${typeIcons[r.rule_type] || 'fa-file'} text-surface-400"></i><span class="text-xs">${r.rule_type?.replace(/_/g, ' ')}</span></span></td>
            <td class="text-sm font-medium">${r.title}</td>
            <td><div class="flex flex-wrap gap-1">${(r.commodity_categories || []).slice(0, 3).map(c => `<span class="badge badge-info text-[9px]">${c}</span>`).join('')}</div></td>
            <td><span class="badge badge-${severityColors[r.severity] || 'neutral'}">${r.severity}</span></td>
            <td><span class="badge badge-${r.enforcement_action === 'BLOCK' ? 'danger' : r.enforcement_action === 'WARN' ? 'warning' : 'neutral'}">${r.enforcement_action}</span></td>
          </tr>`).join('')}
        </tbody></table></div>
      </div>

      <!-- Recent Compliance Checks -->
      ${checks.length > 0 ? `<div class="sgtx-card p-6">
        <h2 class="text-lg font-bold mb-4"><i class="fas fa-history text-surface-500 mr-2"></i>Recent Compliance Checks</h2>
        <div class="overflow-x-auto"><table class="sgtx-table"><thead><tr>
          <th>Rule</th><th>Title</th><th>Country</th><th>Result</th><th>Checked</th><th>Remediation</th>
        </tr></thead><tbody>
          ${checks.slice(0, 20).map(c => `<tr>
            <td class="font-mono text-xs">${c.rule_code || '—'}</td>
            <td class="text-sm">${c.rule_title || '—'}</td>
            <td>${c.country_code || '—'}</td>
            <td><span class="badge badge-${resultColors[c.check_result] || 'neutral'}">${c.check_result}</span></td>
            <td class="text-xs">${time(c.checked_at)}</td>
            <td class="text-xs text-surface-500">${c.remediation || '—'}</td>
          </tr>`).join('')}
        </tbody></table></div>
      </div>` : ''}
    </div>`;
}

async function runComplianceCheck() {
  const dest = document.getElementById('cc-dest')?.value || '';
  const commodity = document.getElementById('cc-commodity')?.value || '';
  const hs = document.getElementById('cc-hs')?.value || '';
  const resultsDiv = document.getElementById('cc-results');
  resultsDiv.innerHTML = '<div class="text-center py-4"><i class="fas fa-spinner fa-spin text-gold-400 mr-2"></i>Running compliance check...</div>';

  try {
    const r = await apiPost('/gov/compliance-check', {
      dest_country: dest, commodity_type: commodity, hs_code: hs, tenant_id: tenant?.id,
    });
    const s = r.summary || {};
    const checks = r.checks || [];

    const overallColor = s.overall === 'PASS' ? 'emerald' : s.overall === 'FAIL' ? 'red' : 'amber';
    const overallIcon = s.overall === 'PASS' ? 'fa-check-circle' : s.overall === 'FAIL' ? 'fa-times-circle' : 'fa-exclamation-triangle';

    resultsDiv.innerHTML = `
      <div class="p-4 rounded-lg bg-${overallColor}-50 border border-${overallColor}-200 mb-4">
        <div class="flex items-center gap-2 mb-2"><i class="fas ${overallIcon} text-${overallColor}-500 text-lg"></i><span class="font-bold text-${overallColor}-700">Overall: ${s.overall}</span></div>
        <div class="text-sm text-${overallColor}-600">${s.total} rule(s) checked — ${s.passed} passed, ${s.warnings} warnings, ${s.failed} failed</div>
      </div>
      <div class="space-y-2">${checks.map(ch => `
        <div class="flex items-center justify-between p-3 rounded-lg border ${ch.result === 'PASS' ? 'border-emerald-200 bg-emerald-50/50' : ch.result === 'FAIL' ? 'border-red-200 bg-red-50/50' : 'border-amber-200 bg-amber-50/50'}">
          <div class="flex items-center gap-3">
            <i class="fas ${ch.result === 'PASS' ? 'fa-check-circle text-emerald-500' : ch.result === 'FAIL' ? 'fa-times-circle text-red-500' : 'fa-exclamation-triangle text-amber-500'}"></i>
            <div><div class="text-sm font-medium">${ch.title}</div><div class="text-[10px] text-surface-400">${ch.rule_code} · ${ch.severity}</div></div>
          </div>
          <span class="badge badge-${ch.result === 'PASS' ? 'success' : ch.result === 'FAIL' ? 'danger' : 'warning'}">${ch.result}</span>
        </div>
      `).join('')}</div>`;
  } catch(e) { resultsDiv.innerHTML = `<div class="text-red-500 text-sm"><i class="fas fa-exclamation-circle mr-1"></i>Check failed: ${e.message}</div>`; }
}


// ─────────────────────────────────────────────────────────────────────────────
// 4. ENHANCED QUOTE REVIEW — Full Comparison Table (Buyer side)
// ─────────────────────────────────────────────────────────────────────────────
// Override the existing renderQuoteReview with comprehensive version
const _originalRenderQuoteReview = typeof renderQuoteReview === 'function' ? renderQuoteReview : null;

async function renderQuoteReviewEnhanced() {
  setTitle('Quote Review & Negotiation', 'Compare seller quotes, landed cost breakdown, counter-offer — Blueprint Tab 3');
  const content = document.getElementById('content');

  // Get trades with pending quotes
  let trades = [];
  try {
    const r = await api('/trades?tenant_id=' + tenant?.id + '&role=buyer');
    trades = (r.data || []).filter(t => ['PENDING_EXPORTER_RESPONSE', 'QUOTED', 'NEGOTIATING'].includes(t.status));
  } catch(e) {}

  if (trades.length === 0) {
    content.innerHTML = `<div class="sgtx-card p-10 text-center"><i class="fas fa-scale-balanced text-4xl text-surface-300 mb-4 block"></i><h3 class="text-lg font-bold text-surface-600 mb-2">No Quotes to Review</h3><p class="text-surface-400">Quotes from sellers will appear here once submitted</p></div>`;
    return;
  }

  content.innerHTML = `
    <div class="space-y-6">
      <div class="sgtx-card p-6">
        <h2 class="text-lg font-bold mb-4"><i class="fas fa-inbox text-gold-400 mr-2"></i>Trade Requests with Quotes</h2>
        <div class="space-y-3">
          ${trades.map(t => {
            let specs = {};
            try { specs = JSON.parse(t.parsed_specs || '{}'); } catch {}
            return `<div class="p-4 rounded-xl border border-surface-200 hover:border-gold-300 cursor-pointer transition" onclick="loadQuoteComparison('${t.id}')">
              <div class="flex items-center justify-between">
                <div>
                  <div class="font-semibold">${specs.commodity_type || 'Trade'} — ${specs.containers?.length || '?'} container(s)</div>
                  <div class="text-xs text-surface-400">${t.id.slice(0, 20)} · ${specs.incoterm || ''} · ${time(t.created_at)}</div>
                </div>
                <div class="flex items-center gap-2">
                  ${badge(t.status)}
                  <i class="fas fa-chevron-right text-surface-300"></i>
                </div>
              </div>
            </div>`;
          }).join('')}
        </div>
      </div>
      <div id="quote-comparison-area"></div>
    </div>`;
}

async function loadQuoteComparison(tradeId) {
  const area = document.getElementById('quote-comparison-area');
  if (!area) return;
  area.innerHTML = '<div class="text-center py-8"><i class="fas fa-spinner fa-spin text-gold-400 mr-2"></i>Loading quote comparison...</div>';

  try {
    const r = await api('/buyer/quote-comparison?trade_request_id=' + tradeId);
    const quotes = r.data || [];
    const specs = r.trade_specs || {};

    if (quotes.length === 0) {
      area.innerHTML = '<div class="sgtx-card p-6 text-center text-surface-400">No quotes received yet for this trade request</div>';
      return;
    }

    area.innerHTML = `
      <div class="sgtx-card p-6">
        <h2 class="text-lg font-bold mb-4"><i class="fas fa-scale-balanced text-gold-400 mr-2"></i>Quote Comparison (${quotes.length} quote${quotes.length > 1 ? 's' : ''})</h2>

        <!-- Comparison Grid -->
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-surface-50">
              <tr>
                <th class="p-3 text-left text-xs font-bold text-surface-500 uppercase">Criteria</th>
                ${quotes.map((q, i) => `<th class="p-3 text-center min-w-[200px]">
                  <div class="font-bold text-sm">${q.seller_name || 'Seller ' + (i + 1)}</div>
                  <div class="text-[10px] text-surface-400">${q.seller_country || ''} · Trust: ${q.seller_trust || '—'}</div>
                  ${i === 0 ? '<span class="badge badge-success text-[9px] mt-1">Best Score</span>' : ''}
                </th>`).join('')}
              </tr>
            </thead>
            <tbody>
              <tr class="border-t"><td class="p-3 font-medium text-surface-600"><i class="fas fa-tag mr-1 text-amber-500"></i>EXW Price</td>
                ${quotes.map(q => `<td class="p-3 text-center font-bold text-lg">${q.exw_currency || 'USD'} ${(q.exw_price || 0).toLocaleString()}</td>`).join('')}</tr>
              <tr class="border-t bg-surface-50/50"><td class="p-3 font-medium text-surface-600"><i class="fas fa-truck mr-1 text-blue-500"></i>Logistics Cost</td>
                ${quotes.map(q => `<td class="p-3 text-center">${q.cost_breakdown?.logistics ? '$' + q.cost_breakdown.logistics.toLocaleString() : '—'}</td>`).join('')}</tr>
              <tr class="border-t"><td class="p-3 font-medium text-surface-600"><i class="fas fa-shield-halved mr-1 text-gold-400"></i>SGTX Fee</td>
                ${quotes.map(q => `<td class="p-3 text-center">${q.cost_breakdown?.sgtx_fee ? '$' + q.cost_breakdown.sgtx_fee.toLocaleString() : '—'}</td>`).join('')}</tr>
              <tr class="border-t bg-surface-50/50"><td class="p-3 font-medium text-surface-600"><i class="fas fa-umbrella mr-1 text-cyan-500"></i>Insurance</td>
                ${quotes.map(q => `<td class="p-3 text-center">${q.cost_breakdown?.insurance ? '$' + q.cost_breakdown.insurance.toLocaleString() : '—'}</td>`).join('')}</tr>
              <tr class="border-t border-t-2 border-gold-200"><td class="p-3 font-bold text-surface-900"><i class="fas fa-calculator mr-1 text-emerald-500"></i>Total Landed Cost</td>
                ${quotes.map(q => `<td class="p-3 text-center font-bold text-lg text-emerald-600">$${(q.landed_cost || 0).toLocaleString()}</td>`).join('')}</tr>
              <tr class="border-t"><td class="p-3 font-medium text-surface-600"><i class="fas fa-clock mr-1 text-surface-400"></i>Validity</td>
                ${quotes.map(q => `<td class="p-3 text-center">${q.exw_validity_days || '—'} days</td>`).join('')}</tr>
              <tr class="border-t bg-surface-50/50"><td class="p-3 font-medium text-surface-600"><i class="fas fa-anchor mr-1 text-surface-400"></i>Alt Ports</td>
                ${quotes.map(q => `<td class="p-3 text-center">${(q.alt_ports || []).length} option(s)</td>`).join('')}</tr>
              <tr class="border-t"><td class="p-3 font-medium text-surface-600"><i class="fas fa-star mr-1 text-amber-500"></i>AI Score</td>
                ${quotes.map(q => `<td class="p-3 text-center"><div class="inline-flex items-center gap-1"><div class="w-16 h-2 bg-surface-100 rounded-full"><div class="h-2 bg-gold-400 rounded-full" style="width:${q.score}%"></div></div><span class="text-xs font-bold">${q.score}/100</span></div></td>`).join('')}</tr>
              <tr class="border-t border-t-2"><td class="p-3 font-medium">Actions</td>
                ${quotes.map(q => `<td class="p-3 text-center">
                  <div class="flex flex-col gap-1">
                    ${q.status === 'SUBMITTED' ? `<button onclick="acceptQuoteDirectly('${q.id}', '${tradeId}')" class="btn-success text-xs py-1 w-full"><i class="fas fa-check mr-1"></i>Accept</button>` : ''}
                    ${q.status === 'SUBMITTED' ? `<button onclick="showCounterOfferForm('${q.id}')" class="btn-secondary text-xs py-1 w-full"><i class="fas fa-handshake mr-1"></i>Counter</button>` : ''}
                    <button onclick="showQuoteDetailModal('${q.id}')" class="text-gold-400 text-xs hover:underline"><i class="fas fa-eye mr-0.5"></i>Full Detail</button>
                  </div>
                </td>`).join('')}</tr>
            </tbody>
          </table>
        </div>
      </div>`;
  } catch(e) {
    area.innerHTML = `<div class="sgtx-card p-6 text-red-500"><i class="fas fa-exclamation-circle mr-1"></i>Failed to load comparison: ${e.message}</div>`;
  }
}

async function acceptQuoteDirectly(quoteId, tradeId) {
  if (!confirm('Accept this quote? This will move to contract phase.')) return;
  try {
    const r = await apiPost('/contracting/accept-quote', { quote_id: quoteId, trade_request_id: tradeId });
    if (r.success || r.contract_id) { showToast('Quote accepted! Contract created.', 'success'); renderQuoteReviewEnhanced(); }
    else showToast(r.error || 'Failed', 'error');
  } catch(e) { showToast('Error: ' + e.message, 'error'); }
}

function showCounterOfferForm(quoteId) {
  showModal('<div class="text-lg font-bold"><i class="fas fa-handshake text-gold-400 mr-2"></i>Counter-Offer</div>',
    `<div class="space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div><label class="text-xs font-medium mb-1 block">Your Counter Price</label><input type="number" id="co-price" step="0.01" placeholder="0.00"></div>
        <div><label class="text-xs font-medium mb-1 block">Currency</label><select id="co-currency"><option value="USD">USD</option><option value="EUR">EUR</option><option value="GBP">GBP</option></select></div>
      </div>
      <div><label class="text-xs font-medium mb-1 block">Reason for Counter-Offer</label><textarea id="co-reason" rows="3" placeholder="Explain why you're proposing a different price..."></textarea></div>
      <div><label class="text-xs font-medium mb-1 block">Requested Changes</label><textarea id="co-changes" rows="2" placeholder="Any changes to delivery terms, timing, etc."></textarea></div>
      <button onclick="submitCounterOffer('${quoteId}')" class="btn-primary w-full"><i class="fas fa-paper-plane mr-2"></i>Send Counter-Offer</button>
    </div>`);
}

async function submitCounterOffer(quoteId) {
  try {
    const r = await apiPost('/buyer/counter-offer', {
      quote_id: quoteId,
      counter_price: parseFloat(document.getElementById('co-price')?.value || '0'),
      counter_currency: document.getElementById('co-currency')?.value || 'USD',
      reason: document.getElementById('co-reason')?.value || '',
      requested_changes: document.getElementById('co-changes')?.value || '',
    });
    if (r.success) { closeModal(); showToast('Counter-offer sent', 'success'); }
    else showToast(r.error || 'Failed', 'error');
  } catch(e) { showToast('Error: ' + e.message, 'error'); }
}

function showQuoteDetailModal(quoteId) {
  showToast('Loading full quote details...', 'info');
  // Reuse existing showQuoteDetail if available
  if (typeof showQuoteDetail === 'function') showQuoteDetail(quoteId);
}

// Re-register enhanced version
if (typeof renderQuoteReview !== 'undefined') {
  // Patch the pageRenderers to use enhanced version
  if (typeof pageRenderers !== 'undefined') pageRenderers['quote-review'] = renderQuoteReviewEnhanced;
}


// ─────────────────────────────────────────────────────────────────────────────
// 5. ENHANCED SMART INBOX — Recommended Actions Widget
// ─────────────────────────────────────────────────────────────────────────────
// We enhance the existing renderSmartInbox by adding recommended actions at the top
const _originalRenderSmartInbox = typeof renderSmartInbox === 'function' ? renderSmartInbox : null;

async function renderSmartInboxEnhanced() {
  // First render the original inbox
  if (_originalRenderSmartInbox) await _originalRenderSmartInbox();

  // Then inject recommended actions widget at the top
  const content = document.getElementById('content');
  if (!content) return;

  try {
    const r = await api('/inbox/recommended-actions?tenant_id=' + tenant?.id);
    const actions = r.actions || [];
    if (actions.length === 0) return;

    const actionColors = { HIGH: 'rose', MEDIUM: 'amber', LOW: 'surface' };

    const widget = document.createElement('div');
    widget.className = 'sgtx-card p-5 mb-6 border-l-4 border-gold-400';
    widget.innerHTML = `
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-bold text-sm"><i class="fas fa-bolt text-gold-400 mr-2"></i>Recommended Actions</h3>
        <span class="badge badge-gold">${actions.length} action${actions.length > 1 ? 's' : ''}</span>
      </div>
      <div class="space-y-2">
        ${actions.map(a => `
          <div class="flex items-center justify-between p-3 rounded-lg bg-surface-50 hover:bg-gold-50/50 border border-surface-200 transition group">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-${a.color || 'sgtx'}-100 flex items-center justify-center"><i class="fas ${a.icon} text-${a.color || 'sgtx'}-500 text-sm"></i></div>
              <div><div class="text-sm font-medium">${a.title}</div><div class="text-[10px] text-surface-400">${a.subtitle || ''}</div></div>
            </div>
            <button onclick="executeRecommendedAction('${a.type}', ${JSON.stringify(a.action_payload).replace(/"/g, '&quot;')})" class="btn-primary text-xs py-1 px-3 opacity-80 group-hover:opacity-100 transition">
              <i class="fas fa-play mr-1"></i>${a.one_click ? 'Execute' : 'View'}
            </button>
          </div>
        `).join('')}
      </div>`;

    content.insertBefore(widget, content.firstChild);
  } catch(e) { /* silent fail for recommended actions */ }
}

async function executeRecommendedAction(type, payload) {
  if (!confirm('Execute this action?')) return;
  try {
    if (type === 'ACCEPT_QUOTE') {
      const r = await apiPost('/contracting/accept-quote', payload);
      showToast(r.success || r.contract_id ? 'Quote accepted!' : (r.error || 'Failed'), r.success || r.contract_id ? 'success' : 'error');
    } else if (type === 'SIGN_CONTRACT') {
      const r = await apiPost('/contracting/sign', payload);
      showToast(r.success ? 'Contract signed!' : (r.error || 'Failed'), r.success ? 'success' : 'error');
    } else if (type === 'MAKE_PAYMENT') {
      const r = await apiPost('/settlement/execute', payload);
      showToast(r.success ? 'Payment processed!' : (r.error || 'Failed'), r.success ? 'success' : 'error');
    }
    renderSmartInboxEnhanced();
  } catch(e) { showToast('Action failed: ' + e.message, 'error'); }
}

// Patch into page renderers
if (typeof pageRenderers !== 'undefined') {
  pageRenderers['smart-inbox'] = renderSmartInboxEnhanced;
}


// ═══════════════════════════════════════════════════════════
// LEGACY SUPPORT — Functions called by trade_forms.js
// ═══════════════════════════════════════════════════════════
function showTradeWizard() { if (typeof showTradeWizardV2 === 'function') showTradeWizardV2(); }
function showQuoteForm(tradeId) { if (typeof showExporterQuoteFormV2 === 'function') showExporterQuoteFormV2(tradeId); }
async function resolveGTID(gtid) {
  const preview = document.getElementById('gtid-preview');
  if (!preview || gtid.length < 15) { if(preview) preview.innerHTML = ''; return; }
  try {
    const r = await api('/gtid/resolve?gtid=' + encodeURIComponent(gtid));
    if (r.data) preview.innerHTML = `<span class="text-emerald-600"><i class="fas fa-check-circle mr-1"></i>${r.data.legal_name} (${r.data.jurisdiction}) — Trust: ${r.data.trust_score || '—'}</span>`;
    else preview.innerHTML = '<span class="text-red-500"><i class="fas fa-times-circle mr-1"></i>GTID not found</span>';
  } catch(e) { preview.innerHTML = ''; }
}

// ═══════════════════════════════════════════════════════════════════════════════
// SHIPPING LINE PORTAL — Full Implementation (Blueprint Part 12C.4)
// ═══════════════════════════════════════════════════════════════════════════════

async function renderShipDashboard() {
  setTitle('Shipping Line Operations', 'Fleet management & booking operations');
  const tid = tenant?.id || '';
  let bookings = [], vessels = [];
  try { bookings = (await api('/ship/bookings?tenant_id=' + tid)).data || []; } catch(e) {}
  try { vessels = (await api('/ship/vessels?tenant_id=' + tid)).data || []; } catch(e) {}
  const pending = bookings.filter(b => b.status === 'PENDING').length;
  const confirmed = bookings.filter(b => b.status === 'CONFIRMED').length;
  const activeVessels = vessels.filter(v => v.status === 'SCHEDULED' || v.status === 'IN_TRANSIT').length;
  document.getElementById('content').innerHTML = `
    <div class="grid grid-cols-4 gap-4 mb-6">
      ${metricCard('fa-calendar-check', 'Pending Bookings', pending, null, 'amber')}
      ${metricCard('fa-ship', 'Confirmed', confirmed, null, 'emerald')}
      ${metricCard('fa-anchor', 'Active Vessels', activeVessels, null, 'blue')}
      ${metricCard('fa-file-lines', 'eBLs Issued', bookings.length, null, 'purple')}
    </div>
    <div class="grid grid-cols-2 gap-6">
      <div class="glass-card p-5">
        <h3 class="font-semibold text-surface-800 mb-3"><i class="fas fa-calendar-check mr-2 text-amber-500"></i>Recent Booking Requests</h3>
        <div class="space-y-2">${bookings.slice(0,5).map(b => `
          <div class="flex items-center justify-between p-2 rounded-lg bg-surface-50 hover:bg-surface-100 transition">
            <div><span class="font-mono text-xs">${b.ustn || b.id}</span> <span class="text-surface-500 text-xs">${b.origin_port}→${b.destination_port}</span></div>
            <div>${badge(b.status)}</div>
          </div>`).join('') || '<p class="text-surface-400 text-sm">No bookings yet</p>'}</div>
      </div>
      <div class="glass-card p-5">
        <h3 class="font-semibold text-surface-800 mb-3"><i class="fas fa-ship mr-2 text-blue-500"></i>Vessel Schedule</h3>
        <div class="space-y-2">${vessels.slice(0,5).map(v => `
          <div class="flex items-center justify-between p-2 rounded-lg bg-surface-50">
            <div><span class="font-semibold text-sm">${v.vessel_name}</span> <span class="text-surface-400 text-xs">${v.voyage_number}</span></div>
            <div class="text-xs text-surface-500">${v.departure_date || '—'} → ${v.arrival_date || '—'}</div>
          </div>`).join('') || '<p class="text-surface-400 text-sm">No vessels scheduled</p>'}</div>
      </div>
    </div>`;
}

async function renderShipBookingRequests() {
  setTitle('Booking Requests', 'Mode C — Direct shipping line requests');
  const tid = tenant?.id || '';
  let bookings = [];
  try { bookings = (await api('/ship/bookings?tenant_id=' + tid)).data || []; } catch(e) {}
  document.getElementById('content').innerHTML = `
    <div class="grid grid-cols-4 gap-4 mb-6">
      ${metricCard('fa-clock', 'Pending', bookings.filter(b=>b.status==='PENDING').length, null, 'amber')}
      ${metricCard('fa-check-circle', 'Confirmed', bookings.filter(b=>b.status==='CONFIRMED').length, null, 'emerald')}
      ${metricCard('fa-paper-plane', 'Quoted', bookings.filter(b=>b.status==='QUOTED').length, null, 'blue')}
      ${metricCard('fa-times-circle', 'Declined', bookings.filter(b=>b.status==='DECLINED').length, null, 'red')}
    </div>
    <div class="glass-card p-5">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="text-left text-surface-500 text-xs border-b">
            <th class="pb-2">USTN</th><th class="pb-2">Route</th><th class="pb-2">Container</th>
            <th class="pb-2">Volume</th><th class="pb-2">Status</th><th class="pb-2">Actions</th>
          </tr></thead>
          <tbody>${bookings.map(b => `<tr class="border-b border-surface-100 hover:bg-surface-50">
            <td class="py-2 font-mono text-xs">${b.ustn || b.id}</td>
            <td class="py-2">${b.origin_port} → ${b.destination_port}</td>
            <td class="py-2">${b.container_count}×${b.container_type}</td>
            <td class="py-2">${b.volume_cbm} CBM</td>
            <td class="py-2">${badge(b.status)}</td>
            <td class="py-2">${b.status === 'PENDING' ? `
              <button onclick="shipSendQuote('${b.id}')" class="btn-xs btn-primary mr-1">Quote</button>
              <button onclick="shipConfirmBooking('${b.id}')" class="btn-xs btn-success mr-1">Confirm</button>
              <button onclick="shipDeclineBooking('${b.id}')" class="btn-xs btn-danger">Decline</button>
            ` : '—'}</td>
          </tr>`).join('')}</tbody>
        </table>
      </div>
    </div>`;
}

async function shipSendQuote(id) {
  const rate = prompt('Enter freight rate (USD):');
  if (!rate) return;
  const vessel = prompt('Vessel name:') || 'TBD';
  try {
    await apiPost('/ship/bookings/' + id + '/quote', { freight_rate: parseFloat(rate), vessel_name: vessel, voyage_number: 'V-' + Date.now().toString().slice(-6) });
    showToast('Quote sent successfully', 'success');
    renderShipBookingRequests();
  } catch(e) { showToast('Failed to send quote', 'error'); }
}

async function shipConfirmBooking(id) {
  const vessel = prompt('Vessel name:');
  if (!vessel) return;
  try {
    await apiPost('/ship/bookings/' + id + '/confirm', { vessel_name: vessel, voyage_number: 'V-' + Date.now().toString().slice(-6), departure_date: new Date(Date.now() + 7*86400000).toISOString().slice(0,10), arrival_date: new Date(Date.now() + 21*86400000).toISOString().slice(0,10) });
    showToast('Booking confirmed', 'success');
    renderShipBookingRequests();
  } catch(e) { showToast('Failed', 'error'); }
}

async function shipDeclineBooking(id) {
  const reason = prompt('Decline reason:');
  if (!reason) return;
  try {
    await apiPost('/ship/bookings/' + id + '/decline', { reason });
    showToast('Booking declined', 'success');
    renderShipBookingRequests();
  } catch(e) { showToast('Failed', 'error'); }
}

async function renderShipEBL() {
  setTitle('eBL Management', 'Electronic Bills of Lading — Issue, transfer & surrender');
  const tid = tenant?.id || '';
  let ebls = [];
  try { ebls = (await api('/ship/ebl?tenant_id=' + tid)).data || []; } catch(e) {}
  document.getElementById('content').innerHTML = `
    <div class="grid grid-cols-4 gap-4 mb-6">
      ${metricCard('fa-file-lines', 'Total eBLs', ebls.length, null, 'blue')}
      ${metricCard('fa-check-double', 'Issued', ebls.filter(e=>e.status==='ISSUED').length, null, 'emerald')}
      ${metricCard('fa-exchange-alt', 'Transferred', ebls.filter(e=>e.status==='TRANSFERRED').length, null, 'purple')}
      ${metricCard('fa-flag-checkered', 'Surrendered', ebls.filter(e=>e.status==='SURRENDERED').length, null, 'amber')}
    </div>
    <div class="glass-card p-5 mb-4">
      <h3 class="font-semibold mb-3"><i class="fas fa-plus-circle mr-2 text-gold-400"></i>Issue New eBL</h3>
      <div class="grid grid-cols-3 gap-3">
        <input id="ebl-shipper" placeholder="Shipper" class="form-input">
        <input id="ebl-consignee" placeholder="Consignee" class="form-input">
        <input id="ebl-vessel" placeholder="Vessel Name" class="form-input">
        <input id="ebl-voyage" placeholder="Voyage No." class="form-input">
        <input id="ebl-pol" placeholder="Port of Loading" class="form-input">
        <input id="ebl-pod" placeholder="Port of Discharge" class="form-input">
      </div>
      <button onclick="issueEBL()" class="btn-primary mt-3"><i class="fas fa-file-signature mr-1"></i>Issue eBL</button>
    </div>
    <div class="glass-card p-5">
      <table class="w-full text-sm">
        <thead><tr class="text-left text-surface-500 text-xs border-b">
          <th class="pb-2">eBL ID</th><th class="pb-2">USTN</th><th class="pb-2">Shipper</th>
          <th class="pb-2">Consignee</th><th class="pb-2">Route</th><th class="pb-2">Status</th><th class="pb-2">Actions</th>
        </tr></thead>
        <tbody>${ebls.map(e => `<tr class="border-b border-surface-100">
          <td class="py-2 font-mono text-xs">${e.id}</td>
          <td class="py-2 font-mono text-xs">${e.ustn || '—'}</td>
          <td class="py-2">${e.shipper || '—'}</td>
          <td class="py-2">${e.consignee || '—'}</td>
          <td class="py-2 text-xs">${e.port_of_loading}→${e.port_of_discharge}</td>
          <td class="py-2">${badge(e.status)}</td>
          <td class="py-2">${e.status === 'ISSUED' ? `<button onclick="transferEBL('${e.id}')" class="btn-xs btn-primary">Transfer</button>` : '—'}</td>
        </tr>`).join('')}</tbody>
      </table>
    </div>`;
}

async function issueEBL() {
  const data = { shipper: document.getElementById('ebl-shipper').value, consignee: document.getElementById('ebl-consignee').value, vessel_name: document.getElementById('ebl-vessel').value, voyage_number: document.getElementById('ebl-voyage').value, port_of_loading: document.getElementById('ebl-pol').value, port_of_discharge: document.getElementById('ebl-pod').value, issuer_tenant_id: tenant?.id || '' };
  try { await apiPost('/ship/ebl/issue', data); showToast('eBL issued successfully', 'success'); renderShipEBL(); }
  catch(e) { showToast('Failed to issue eBL', 'error'); }
}

async function transferEBL(id) {
  const newConsignee = prompt('Transfer to (new consignee):');
  if (!newConsignee) return;
  try { await apiPost('/ship/ebl/' + id + '/transfer', { new_consignee: newConsignee }); showToast('eBL transferred', 'success'); renderShipEBL(); }
  catch(e) { showToast('Transfer failed', 'error'); }
}

async function renderShipVesselSchedule() {
  setTitle('Vessel Schedule', 'Fleet rotations & capacity management');
  const tid = tenant?.id || '';
  let vessels = [];
  try { vessels = (await api('/ship/vessels?tenant_id=' + tid)).data || []; } catch(e) {}
  document.getElementById('content').innerHTML = `
    <div class="grid grid-cols-3 gap-4 mb-6">
      ${metricCard('fa-ship', 'Active Vessels', vessels.length, null, 'blue')}
      ${metricCard('fa-box', 'Total Capacity', vessels.reduce((s,v)=>s+(v.capacity_teu||0),0).toLocaleString() + ' TEU', null, 'purple')}
      ${metricCard('fa-box-open', 'Available', vessels.reduce((s,v)=>s+(v.available_teu||0),0).toLocaleString() + ' TEU', null, 'emerald')}
    </div>
    <div class="glass-card p-5">
      <table class="w-full text-sm">
        <thead><tr class="text-left text-surface-500 text-xs border-b">
          <th class="pb-2">Vessel</th><th class="pb-2">Voyage</th><th class="pb-2">Route</th>
          <th class="pb-2">Departure</th><th class="pb-2">Arrival</th><th class="pb-2">Capacity</th><th class="pb-2">Status</th>
        </tr></thead>
        <tbody>${vessels.map(v => {
          let ports = [];
          try { ports = JSON.parse(v.route_ports || '[]'); } catch(e) {}
          return `<tr class="border-b border-surface-100">
            <td class="py-2 font-semibold">${v.vessel_name}</td>
            <td class="py-2 font-mono text-xs">${v.voyage_number}</td>
            <td class="py-2 text-xs">${ports.join(' → ')}</td>
            <td class="py-2">${v.departure_date || '—'}</td>
            <td class="py-2">${v.arrival_date || '—'}</td>
            <td class="py-2">${v.available_teu}/${v.capacity_teu} TEU</td>
            <td class="py-2">${badge(v.status)}</td>
          </tr>`;
        }).join('')}</tbody>
      </table>
    </div>`;
}

async function renderShipFreightInvoices() {
  setTitle('Freight Invoices', 'Generate and track freight charges');
  const tid = tenant?.id || '';
  let invoices = [];
  try { invoices = (await api('/ship/invoices?tenant_id=' + tid)).data || []; } catch(e) {}
  document.getElementById('content').innerHTML = `
    <div class="grid grid-cols-3 gap-4 mb-6">
      ${metricCard('fa-file-invoice-dollar', 'Total Invoices', invoices.length, null, 'blue')}
      ${metricCard('fa-dollar-sign', 'Total Value', usd(invoices.reduce((s,i)=>s+(i.amount||0),0)), null, 'emerald')}
      ${metricCard('fa-clock', 'Pending Payment', invoices.filter(i=>i.status==='ISSUED').length, null, 'amber')}
    </div>
    <div class="glass-card p-5">
      <button onclick="generateFreightInvoice()" class="btn-primary mb-4"><i class="fas fa-plus mr-1"></i>Generate Invoice</button>
      <table class="w-full text-sm">
        <thead><tr class="text-left text-surface-500 text-xs border-b">
          <th class="pb-2">Invoice ID</th><th class="pb-2">USTN</th><th class="pb-2">Amount</th>
          <th class="pb-2">Terms</th><th class="pb-2">Due Date</th><th class="pb-2">Status</th>
        </tr></thead>
        <tbody>${invoices.map(i => `<tr class="border-b border-surface-100">
          <td class="py-2 font-mono text-xs">${i.id}</td>
          <td class="py-2 font-mono text-xs">${i.ustn || '—'}</td>
          <td class="py-2 font-semibold">${usd(i.amount)}</td>
          <td class="py-2">${i.payment_terms}</td>
          <td class="py-2">${i.due_date || '—'}</td>
          <td class="py-2">${badge(i.status)}</td>
        </tr>`).join('')}</tbody>
      </table>
    </div>`;
}

async function generateFreightInvoice() {
  const bookingId = prompt('Booking ID:');
  const amount = prompt('Amount (USD):');
  if (!bookingId || !amount) return;
  try {
    await apiPost('/ship/invoices/generate', { booking_id: bookingId, amount: parseFloat(amount), issuer_tenant_id: tenant?.id, currency: 'USD', payment_terms: 'NET30', due_date: new Date(Date.now() + 30*86400000).toISOString().slice(0,10) });
    showToast('Invoice generated', 'success'); renderShipFreightInvoices();
  } catch(e) { showToast('Failed', 'error'); }
}

async function renderShipContractRates() {
  setTitle('Contract Rate Manager', 'Manage preferential rates for regular customers');
  const tid = tenant?.id || '';
  let rates = [];
  try { rates = (await api('/ship/contract-rates?tenant_id=' + tid)).data || []; } catch(e) {}
  document.getElementById('content').innerHTML = `
    <div class="glass-card p-5 mb-4">
      <h3 class="font-semibold mb-3"><i class="fas fa-handshake mr-2 text-gold-400"></i>Add Contract Rate</h3>
      <div class="grid grid-cols-4 gap-3">
        <input id="cr-origin" placeholder="Origin Port" class="form-input">
        <input id="cr-dest" placeholder="Destination Port" class="form-input">
        <input id="cr-rate" placeholder="Rate per TEU (USD)" class="form-input" type="number">
        <input id="cr-min" placeholder="Min Volume (TEU)" class="form-input" type="number">
      </div>
      <button onclick="addContractRate()" class="btn-primary mt-3"><i class="fas fa-plus mr-1"></i>Add Rate</button>
    </div>
    <div class="glass-card p-5">
      <table class="w-full text-sm">
        <thead><tr class="text-left text-surface-500 text-xs border-b">
          <th class="pb-2">Route</th><th class="pb-2">Container</th><th class="pb-2">Rate/TEU</th>
          <th class="pb-2">Min Vol</th><th class="pb-2">Valid</th><th class="pb-2">Status</th>
        </tr></thead>
        <tbody>${rates.map(r => `<tr class="border-b border-surface-100">
          <td class="py-2">${r.route_origin} → ${r.route_destination}</td>
          <td class="py-2">${r.container_type}</td>
          <td class="py-2 font-semibold">${usd(r.rate_per_teu)}</td>
          <td class="py-2">${r.min_volume_teu} TEU</td>
          <td class="py-2 text-xs">${r.valid_from || '—'} — ${r.valid_to || '—'}</td>
          <td class="py-2">${badge(r.status)}</td>
        </tr>`).join('')}</tbody>
      </table>
    </div>`;
}

async function addContractRate() {
  try {
    await apiPost('/ship/contract-rates', { shipping_line_tenant_id: tenant?.id, route_origin: document.getElementById('cr-origin').value, route_destination: document.getElementById('cr-dest').value, rate_per_teu: parseFloat(document.getElementById('cr-rate').value) || 0, min_volume_teu: parseInt(document.getElementById('cr-min').value) || 0, container_type: '40HC', valid_from: new Date().toISOString().slice(0,10), valid_to: new Date(Date.now()+365*86400000).toISOString().slice(0,10) });
    showToast('Contract rate added', 'success'); renderShipContractRates();
  } catch(e) { showToast('Failed', 'error'); }
}

async function renderShipPerformance() {
  setTitle('Performance', 'Shipping line KPIs & benchmarks');
  document.getElementById('content').innerHTML = `
    <div class="grid grid-cols-4 gap-4 mb-6">
      ${metricCard('fa-clock', 'On-Time Arrival', '96.2%', null, 'emerald')}
      ${metricCard('fa-triangle-exclamation', 'Dispute Rate', '0.8%', null, 'emerald')}
      ${metricCard('fa-ship', 'Avg Transit Days', '14.2', null, 'blue')}
      ${metricCard('fa-star', 'Rating', '4.7/5', null, 'amber')}
    </div>
    <div class="glass-card p-5">
      <h3 class="font-semibold mb-3">Monthly Booking Volume</h3>
      <canvas id="ship-perf-chart" height="200"></canvas>
    </div>`;
  setTimeout(() => {
    const ctx = document.getElementById('ship-perf-chart');
    if (ctx && window.Chart) new Chart(ctx, { type: 'bar', data: { labels: ['Jan','Feb','Mar','Apr','May','Jun'], datasets: [{ label: 'Bookings', data: [45,52,48,61,55,63], backgroundColor: 'rgba(124,62,237,0.6)' }] }, options: { responsive: true, plugins: { legend: { display: false } } } });
  }, 100);
}

